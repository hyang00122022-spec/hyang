# Secretary Agent configuration
# Copy this file to .env and adjust values

BUSINESS_NAME="Your Business Sdn Bhd"
BUSINESS_EMAIL="accounts@yourbusiness.my"
BUSINESS_CURRENCY="MYR"

# Reconciliation tolerance (S2)
RECON_TOLERANCE_SMALL=1.00
RECON_TOLERANCE_LARGE=5.00
RECON_SMALL_THRESHOLD=100.00

# Confidence threshold (S7)
CONFIDENCE_THRESHOLD=0.70

# Escalation threshold (S6)
LARGE_AMOUNT_THRESHOLD=10000.00

# Gmail Crawler settings
# See prompts/gmail_setup_guide.md for OAuth setup
GMAIL_MAX_RESULTS=50
# Comma-separated vendor domains (empty = accept all)
# e.g. GMAIL_VENDOR_DOMAINS=techsupplies.com.my,pangsapila.my
GMAIL_VENDOR_DOMAINS=
