{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalReport",
  "description": "Final report produced by the Secretary (P1). Contains cash flow summary, category breakdown, and top 3 recommended actions.",
  "type": "object",
  "required": [
    "goal", "period", "cash_in", "cash_out", "net_cash",
    "categories", "top_3_actions", "total_exceptions",
    "tasks_generated", "chase_emails_drafted", "chase_emails_approved", "generated_at"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "description": "The original business goal"
    },
    "period": {
      "type": "string",
      "description": "Time period covered (e.g. 'September 2026')"
    },
    "cash_in": {
      "type": "number",
      "description": "Total incoming (receipts)"
    },
    "cash_out": {
      "type": "number",
      "description": "Total outgoing (invoices paid)"
    },
    "net_cash": {
      "type": "number",
      "description": "Net cash flow (cash_in - cash_out)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "total", "count"],
        "properties": {
          "category": {
            "type": "string",
            "description": "Category code (e.g. RAW, RENT, SAL)"
          },
          "total": {
            "type": "number",
            "description": "Total amount in this category"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of documents in this category"
          }
        },
        "additionalProperties": false
      },
      "description": "Spending breakdown by category (S5)"
    },
    "top_3_actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      },
      "description": "Top 3 recommended actions for the business owner"
    },
    "total_exceptions": {
      "type": "integer",
      "minimum": 0,
      "description": "Total exceptions raised by Financial agent"
    },
    "tasks_generated": {
      "type": "integer",
      "minimum": 0,
      "description": "Total tasks generated by Secretary"
    },
    "chase_emails_drafted": {
      "type": "integer",
      "minimum": 0,
      "description": "Total chase emails drafted"
    },
    "chase_emails_approved": {
      "type": "integer",
      "minimum": 0,
      "description": "Total chase emails approved by owner"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of report generation"
    }
  },
  "additionalProperties": false
}
