{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gmail Raw Email Document",
  "description": "Schema for emails fetched by the Gmail Crawler containing invoice/receipt/PO attachments",
  "type": "object",
  "required": ["message_id", "sender", "sender_email", "subject", "date", "has_attachment"],
  "properties": {
    "message_id": {
      "type": "string",
      "description": "Gmail message ID"
    },
    "thread_id": {
      "type": "string",
      "description": "Gmail thread ID"
    },
    "sender": {
      "type": "string",
      "description": "Full sender header, e.g. 'Vendor Name <email@domain.com>'"
    },
    "sender_email": {
      "type": "string",
      "format": "email",
      "description": "Extracted email address"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "date": {
      "type": "string",
      "description": "Email date in ISO 8601 format"
    },
    "body_snippet": {
      "type": "string",
      "description": "First ~200 characters of email body (plain text)"
    },
    "has_attachment": {
      "type": "boolean",
      "description": "Whether the email has any downloadable attachments"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename"],
        "properties": {
          "filename": {
            "type": "string",
            "description": "Attachment filename"
          },
          "mime_type": {
            "type": "string",
            "description": "MIME type of the attachment"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Size in bytes"
          },
          "attachment_id": {
            "type": "string",
            "description": "Gmail attachment ID for API download"
          },
          "downloaded": {
            "type": "boolean",
            "description": "Whether the file has been downloaded locally"
          },
          "local_path": {
            "type": ["string", "null"],
            "description": "Local file path if downloaded"
          }
        }
      }
    },
    "downloaded_files": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Local file paths of downloaded attachments"
    },
    "detected_doc_type": {
      "type": "string",
      "enum": ["invoice", "receipt", "PO", "unknown"],
      "description": "Document type detected from subject/filename"
    },
    "vendor_name": {
      "type": "string",
      "description": "Vendor name extracted from sender or subject"
    },
    "processed_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when this email was processed"
    }
  }
}
