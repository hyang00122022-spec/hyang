{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "description": "A plain-language task generated by the Secretary from an exception event.",
  "type": "object",
  "required": [
    "task_id", "title", "description", "priority", "event_type",
    "invoice_number", "vendor_name", "amount", "action_required", "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$",
      "description": "Unique task identifier"
    },
    "title": {
      "type": "string",
      "description": "Short title for the task (plain language)"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the issue"
    },
    "priority": {
      "type": "integer",
      "enum": [1, 2, 3, 4],
      "description": "Priority level: 1=Critical, 2=High, 3=Medium, 4=Low"
    },
    "event_type": {
      "type": "string",
      "enum": ["overdue", "duplicate", "escalation", "flagged"],
      "description": "Original event type that generated this task"
    },
    "invoice_number": {
      "type": "string",
      "description": "Related invoice number"
    },
    "vendor_name": {
      "type": "string",
      "description": "Related vendor name"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Amount in MYR"
    },
    "action_required": {
      "type": "string",
      "description": "What the business owner needs to do"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "done", "cancelled"],
      "description": "Current task status"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "related_email_id": {
      "type": ["string", "null"],
      "description": "ID of related chase email (if any)"
    }
  },
  "additionalProperties": false
}
