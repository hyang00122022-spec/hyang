{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan",
  "description": "Execution plan generated by the Secretary (P0). Describes what each agent will do and in what order.",
  "type": "object",
  "required": ["goal", "phases", "created_at", "total_phases"],
  "properties": {
    "goal": {
      "type": "string",
      "description": "The business goal for this run"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "agent", "action", "status"],
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": 1,
            "description": "Phase number (sequential)"
          },
          "agent": {
            "type": "string",
            "enum": ["Logistics", "Financial", "Secretary"],
            "description": "Agent responsible for this phase"
          },
          "action": {
            "type": "string",
            "description": "What the agent will do in this phase"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "done", "skipped"],
            "description": "Phase execution status"
          }
        },
        "additionalProperties": false
      },
      "description": "List of execution phases"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of plan creation"
    },
    "total_phases": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of phases"
    }
  },
  "additionalProperties": false
}
